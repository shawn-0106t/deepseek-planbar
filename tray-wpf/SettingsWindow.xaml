<Window x:Class="DeepseekPlanbarTray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="404" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <!-- Margin 28 is shadow fade room: lets the BlurRadius=24 shadow decay
         to zero before the window edge -->
    <Border CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- 自定义标题栏（可拖动） -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16" MouseLeftButtonDown="TitleBarDrag">
                <Image Source="pack://application:,,,/deepseek-logo.png" Width="18" Height="18"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="DeepSeek Planbar Settings" FontSize="15" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <Button Content="✕" Style="{StaticResource ChromeCloseButton}"
                        DockPanel.Dock="Right" Click="CloseClick"/>
            </DockPanel>

            <StackPanel Grid.Row="1" Margin="6,0,4,0">
                <TextBlock Text="API Key" FontSize="13" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="ApiKeyBox" Style="{StaticResource ThemedPasswordBox}"
                             Margin="0,8,0,0"/>
                <TextBlock Text="Created in the platform.deepseek.com console; used only to query balance. Saved only after verification passes."
                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <TextBlock x:Name="ApiKeyStatus" Text="" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>

                <TextBlock Text="Usage Token" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <PasswordBox x:Name="UserTokenBox" Style="{StaticResource ThemedPasswordBox}"
                             Margin="0,8,0,0"/>
                <TextBlock Text="How to get it: sign in at platform.deepseek.com in your browser → press F12 → Console → paste and run the command (use the button below to copy it) → paste the output into the box above"
                           FontSize="11" TextWrapping="Wrap" Margin="0,6,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button x:Name="CopyCmdButton" Content="Copy Console Command"
                        Style="{StaticResource ActionButton}" Margin="0,6,0,0"
                        Click="CopyCmdClick"/>
                <TextBlock x:Name="TokenStatus" Text="" FontSize="11" TextWrapping="Wrap"
                           Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}"/>
                <Button Content="Sign in via browser to sync (recommended)" Style="{StaticResource ActionButton}"
                        Margin="0,8,0,0" Click="SyncClick"/>

                <TextBlock Text="Theme" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <RadioButton x:Name="ThemeSystem" Content="Follow system" Margin="0,10,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeLight" Content="Light" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>
                <RadioButton x:Name="ThemeDark" Content="Dark" Margin="0,8,0,0"
                             GroupName="theme" Style="{StaticResource ThemeRadio}"/>

                <TextBlock Text="Refresh Interval" FontSize="13" FontWeight="SemiBold" Margin="0,18,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                <StackPanel x:Name="IntervalPanel" Orientation="Horizontal" Margin="0,10,0,0">
                    <RadioButton Content="1 min" Tag="1" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="5 min" Tag="5" GroupName="interval" IsChecked="True"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="10 min" Tag="10" GroupName="interval"
                                 Style="{StaticResource PillRadio}" Margin="0,0,6,0"/>
                    <RadioButton Content="30 min" Tag="30" GroupName="interval"
                                 Style="{StaticResource PillRadio}"/>
                </StackPanel>

                <CheckBox x:Name="AutoStartBox" Content="Launch at startup" Margin="0,20,0,0"
                          Style="{StaticResource ThemeCheckBox}"/>

                <Grid Margin="0,22,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" x:Name="SaveButton" Content="Save"
                            Style="{StaticResource ActionButton}" Click="SaveClick" Margin="0,0,6,0"/>
                    <Button Grid.Column="1" Content="Clear Credentials"
                            Style="{StaticResource ActionButton}" Click="ClearClick" Margin="6,0,0,0"/>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
