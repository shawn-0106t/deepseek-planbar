<Window x:Class="DeepseekPlanbarTray.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="424" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- Margin 28 is shadow fade room: lets the BlurRadius=24 shadow decay
         to zero before the window edge -->
    <Border x:Name="RootBorder" CornerRadius="14" Background="{DynamicResource WindowBgBrush}" Margin="28">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.25" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 头部 -->
            <DockPanel Grid.Row="0" Margin="2,0,2,16">
                <Image Source="pack://application:,,,/deepseek-logo.png" Width="20" Height="20"
                       DockPanel.Dock="Left"/>
                <TextBlock Text="DeepSeek Planbar" FontSize="17" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" Margin="10,0,0,0"/>
                <TextBlock x:Name="LastUpdated" Text="" FontSize="11" DockPanel.Dock="Right"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </DockPanel>

            <!-- 余额卡 -->
            <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" CornerRadius="12"
                    Padding="16" Margin="0,0,0,12">
                <StackPanel>
                    <DockPanel>
                        <TextBlock Text="Account Balance" FontSize="13"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock x:Name="BalanceStatus" Text="" FontSize="12"
                                   DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </DockPanel>
                    <TextBlock x:Name="BalanceTotal" Text="--" FontSize="32" FontWeight="Bold"
                               Margin="0,10,0,10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="BalanceDetail" Text="" FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>
            </Border>

            <!-- 模型用量卡（动态生成，每模型一张） -->
            <StackPanel Grid.Row="2" x:Name="ModelCards"/>

            <!-- 合计行 -->
            <TextBlock Grid.Row="3" x:Name="UsageSummary" Text="" FontSize="11"
                       TextWrapping="Wrap" Margin="4,0,4,12"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>

            <!-- 底部按钮（纯文字，无图标） -->
            <Grid Grid.Row="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Content="Refresh" Style="{StaticResource ActionButton}"
                        Click="RefreshClick" Margin="0,0,6,0"/>
                <Button Grid.Column="1" Content="Settings" Style="{StaticResource ActionButton}"
                        Click="SettingsClick" Margin="3,0"/>
                <Button Grid.Column="2" Content="Exit" Style="{StaticResource ActionButton}"
                        Click="ExitClick" Margin="6,0,0,0"/>
            </Grid>
        </Grid>
    </Border>
</Window>
