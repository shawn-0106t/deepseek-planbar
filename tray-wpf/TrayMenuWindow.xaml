<Window x:Class="DeepseekPlanbarTray.TrayMenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="188" SizeToContent="Height" WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ResizeMode="NoResize">
    <!-- Margin 24 is shadow fade room: lets the BlurRadius=20 shadow decay
         to zero before the window edge (width grew by 2*(24-5) to keep the
         visual card size unchanged) -->
    <Border CornerRadius="12" Background="{DynamicResource WindowBgBrush}" Margin="24" Padding="4">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="2" Opacity="0.3" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <Button Content="Open" Style="{StaticResource MenuItemButton}" Click="OpenClick"/>
            <Button Content="Refresh" Style="{StaticResource MenuItemButton}" Click="RefreshClick"/>
            <Button Content="Settings" Style="{StaticResource MenuItemButton}" Click="SettingsClick"/>
            <Button Content="Exit" Style="{StaticResource MenuItemButton}" Click="ExitClick"/>
        </StackPanel>
    </Border>
</Window>
